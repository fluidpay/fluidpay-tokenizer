{
  "name": "fluidpay-tokenizer",
  "version": "1.15.0",
  "main": "tmp/tokenizer.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "license": "Apache-2.0",
  "repository": "https://github.com/fluidpay/fluidpay-tokenizer",
  "scripts": {
    "dev": "vite --config vite.config.docs.ts",
    "serve": "vite preview",
    "build": "rollup --config src/tokenizer/rollup.config.ts --configPlugin typescript && npm run build:tsc",
    "build:tsc": "vue-tsc --declaration -p tsconfig.build.json",
    "build:docs": "vite --config=vite.config.docs.ts build",
    "lint": "eslint --fix src"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/applepayjs": "^14.0.9",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.40",
    "@vue/eslint-config-typescript": "^14.9.0",
    "ajv": "^8.20.0",
    "eslint": "^10.7.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-vue": "^10.10.0",
    "prismjs": "^1.30.0",
    "rollup": "^4.62.2",
    "rollup-plugin-scss": "^4.0.1",
    "sass": "^1.101.6",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vue": "^3.5.40",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.8"
  }
}
