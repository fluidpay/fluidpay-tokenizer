{
  "name": "fluidpay-tokenizer",
  "version": "1.15.0",
  "main": "tmp/tokenizer.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "license": "Apache-2.0",
  "repository": "https://github.com/fluidpay/fluidpay-tokenizer",
  "scripts": {
    "dev": "vite --config vite.config.docs.ts",
    "serve": "vite preview",
    "build": "rollup --config src/tokenizer/rollup.config.ts --configPlugin typescript && npm run build:tsc",
    "build:tsc": "vue-tsc --declaration -p tsconfig.build.json",
    "build:docs": "vite --config=src/docs/vite.config.ts build",
    "lint": "eslint --fix src"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/applepayjs": "^14.0.9",
    "@types/node": "^24.3.1",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/compiler-sfc": "^3.5.21",
    "@vue/eslint-config-typescript": "^14.6.0",
    "ajv": "^8.17.1",
    "eslint": "^9.34.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-standard": "^5.0.0",
    "eslint-plugin-vue": "^10.4.0",
    "prismjs": "^1.30.0",
    "rollup": "^4.50.0",
    "rollup-plugin-scss": "^4.0.1",
    "sass": "^1.92.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vue": "^3.5.21",
    "vue-eslint-parser": "^10.2.0",
    "vue-router": "^4.5.1",
    "vue-tsc": "^3.0.6"
  }
}
